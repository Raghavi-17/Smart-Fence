# ==========================================
# SMART FENCE - CONFIGURATION TEMPLATE
# ==========================================

# Camera Settings
# Set to 0 for default USB webcam, or path to video file (e.g. datasets/demo.mp4)
# If 0 is not found or fails, the system automatically falls back to the built-in synthetic test feed
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# AI & Detection Settings
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.50
TRACKER_TYPE=bytetrack.yaml

# Virtual Fence & Risk Engine
ALERT_COOLDOWN_SECONDS=5.0
CRITICAL_DWELL_SECONDS=3.0
SIMULATED_FENCE_Y=420

# Hardware & IoT Settings
# IP address of the physical ESP32 device on the local Wi-Fi network
ESP32_IP=192.168.1.150
ESP32_PORT=80
ESP32_TIMEOUT_SECONDS=2.0
# Set to true to enable automated virtual hardware simulation when physical ESP32 is offline
USE_VIRTUAL_ESP32=true

# MQTT (Optional alternative to HTTP)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=smartfence/alerts

# Backend & Database
DATABASE_URL=sqlite:///./smart_fence.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO
